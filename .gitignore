# What stays out of a public repository.
# Everything listed here is either generated, machine-specific, or private working notes.

# Dependencies (restored with `npm install`; three.js ships in vendor/ already)
node_modules/

# Built copies made from this folder: play copy, public beta, itch.io zips (tools/release.js)
builds/
*.zip

# Test stills and capture drivers (tools/shot.js output)
shots/

